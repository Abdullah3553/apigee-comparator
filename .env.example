# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=apigee_monitor
DB_USER=postgres
DB_PASSWORD=postgres

# Backend Configuration
NODE_ENV=development
BACKEND_PORT=3001

# Frontend Configuration
FRONTEND_PORT=3000
VITE_API_BASE_URL=http://localhost:3001

# ===========================================
# MOCK SERVICE CONFIGURATION
# ===========================================
# Set USE_MOCK_SERVICE to "true" to use mock data instead of live Apigee API
# This is useful for local development without Apigee access
USE_MOCK_SERVICE=false

# Mock server URL (used when USE_MOCK_SERVICE=true)
MOCK_SERVER_URL=http://localhost:8080/v1

# Mock server port
MOCK_SERVER_PORT=8080

# Mock server authentication credentials
MOCK_AUTH_USERNAME=mock
MOCK_AUTH_PASSWORD=mock

# Mock server logging level (debug, info, warn, error)
LOG_LEVEL=info

# Enable hot-reload for mock data files (watches for changes)
ENABLE_HOT_RELOAD=true

# ===========================================
# APIGEE INSTANCE CREDENTIALS
# ===========================================
# Pattern: APIGEE_{INSTANCE_NAME}_USERNAME and APIGEE_{INSTANCE_NAME}_PASSWORD
# Instance names should match those in config/apigee-config.yaml

# Example for PROD instance:
APIGEE_PROD_USERNAME=your-username-here
APIGEE_PROD_PASSWORD=your-password-here

# Example for DEV instance:
# APIGEE_DEV_USERNAME=your-dev-username
# APIGEE_DEV_PASSWORD=your-dev-password

# Mock instance credentials (used when USE_MOCK_SERVICE=false but MOCK instance is configured)
APIGEE_MOCK_USERNAME=mock
APIGEE_MOCK_PASSWORD=mock

# Add more instances as needed following the same pattern
