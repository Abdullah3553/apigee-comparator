{
  "keystores": [
    {
      "name": "api-gateway-certs",
      "aliases": ["api-gateway-cert"],
      "certs": ["api-gateway-cert"]
    },
    {
      "name": "api-gateway-trust",
      "aliases": ["root-ca"],
      "certs": ["root-ca"]
    }
  ],
  "aliases": {
    "api-gateway-certs": [
      {
        "alias": "api-gateway-cert",
        "type": "keycert",
        "format": "pem",
        "certificate": "-----BEGIN CERTIFICATE-----\nMIICertDataHere\n-----END CERTIFICATE-----"
      }
    ],
    "api-gateway-trust": [
      {
        "alias": "root-ca",
        "type": "cert",
        "format": "pem",
        "certificate": "-----BEGIN CERTIFICATE-----\nMIICertDataHere\n-----END CERTIFICATE-----"
      }
    ]
  }
}
